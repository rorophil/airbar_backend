# AirBar Backend - Environment Variables (production ET staging partagent ce même docker-compose.yaml)
# Copy this file to .env and update with your secure passwords

# Mode Serverpod à utiliser pour ce déploiement : "production" ou "staging"
# IMPORTANT: Les secrets ci-dessous doivent correspondre à la section config/passwords.yaml du même nom
RUNMODE=production
SERVER_ID=prod-001

# Adresse IP publique de CE serveur (utilisée par Caddy pour émettre son certificat TLS)
# VM de test "staging": 10.211.55.12 — Production: votre IP publique réelle
PUBLIC_ADDRESS=CHANGE_ME_PUBLIC_IP

# PostgreSQL Database Password
# IMPORTANT: Must match config/passwords.yaml -> production -> database
POSTGRES_PASSWORD=-g4x7Ke0FV68yDNSi1xDQpirxejC2580

# Redis Password
REDIS_PASSWORD=VotreMotDePasseRedisSecurise456!

# Serverpod Shared Secret (min 32 chars)
# IMPORTANT: Must match config/passwords.yaml -> production -> serviceSecret
SERVERPOD_PASSWORD_SHARED=k7N45MLCfD2PNbl_IvKc2bYwqn9FM05i

# Service Secret (min 32 chars)
SERVERPOD_PASSWORD_SERVICE_SECRET=k7N45MLCfD2PNbl_IvKc2bYwqn9FM05i

# JWT Refresh Token Hash Pepper (min 32 chars)
# IMPORTANT: Must match config/passwords.yaml -> production -> jwtRefreshTokenHashPepper
SERVERPOD_PASSWORD_JWT_REFRESH_PEPPER=XlrfjPF3mW_lfHT355US_dpcVLxgStfc

# JWT HMAC SHA512 Private Key (min 32 chars)
# IMPORTANT: Must match config/passwords.yaml -> production -> jwtHmacSha512PrivateKey
SERVERPOD_PASSWORD_JWT_HMAC_SHA512_PRIVATE_KEY=QjjCRgRcEwJcjwH2sjbxF9n24TLvIpYL

# Email Secret Hash Pepper (min 32 chars)
# IMPORTANT: Must match config/passwords.yaml -> production -> emailSecretHashPepper
SERVERPOD_PASSWORD_EMAIL_SECRET_HASH_PEPPER=9j7p2HCkJevye1Eo8GndwhKSaw7X2SKd

# SECURITY NOTE:
# - Never commit .env to Git (it's in .gitignore)
# - Use strong, unique passwords in production
# - The passwords here MUST match those in config/passwords.yaml
# - Keep this file secure with proper permissions (chmod 600 .env)
